---
layout: base.njk
metaKey: gallery
---

<div class="container-fluid" id="gallery-banner">
</div>

<div class="container py-4">
  <div class="row">
    <div class="col-12 text-center mb-3">
        <h1>Gallery</h1>
      <p>
        Discover our performances at weddings and events across Cardiff, London, and the UK.<br>
        Every photo captures the energy, elegance, and atmosphere Serenade Strings brings to each special occasion.
      </p>
    </div>
  </div>
</div>

<div id="photos">
  {% for image in json.gallery %}
    <img src="/{{ image.src }}" alt="{{ image.alt | default('Serenade Strings performing at an event') }}">
  {% endfor %}
</div>
