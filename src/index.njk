---
layout: base.njk
metaKey: home
---

<!-- Hero/Callout -->
<section>
  <div class="container-fluid callout-container">
    <div class="opaque-overlay">&nbsp;</div>
    <div class="row">
      <div class="col-12">
        <div class="callout text-center text-white rounded jumbotron">
          <h1 class="jumbotron-header text-white">
            Wedding String Quartet in Cardiff, London & Bristol
          </h1>
          <p>
            Modern, versatile, and professional musicians for weddings and events across the UK. Pop, classical, film, and more—requests always welcome!
          </p>
          <a href="contact.html" class="btn btn-lg btn-success">Get a free quote</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Videos -->
<section>
  <div class="container">
    <div class="row pt-5 pb-3">
      <div class="col-12 col-lg-8 mb-4 mb-md-0">
        <div id="loadedVideo">
          {% set firstVideo = json.videos[0] %}
          <div class="container pt-5">
            <div class="video-wrapper embed-responsive embed-responsive-16by9 d-flex justify-content-center align-items-center">
              <iframe class="embed-responsive-item"
                      src="https://www.youtube.com/embed/{{ firstVideo.videoId | safe }}"
                      title="Serenade Strings Showreel" frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
                      allowfullscreen>
              </iframe>
            </div>
            <div>
              <p class="text-center">Now Playing: {{ firstVideo.title }}</p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-4 pb-3">
        <h3 class="pb-2">Watch More Videos <i class="fas fa-play-circle"></i></h3>
        <ul id="videoList" class="list-group text-center">
          {% for video in json.videos %}
            <li class="custom-list-item d-flex justify-content-between align-items-center border-bottom{% if loop.first %} selected-video{% endif %}"
                data-video-id="{{ video.videoId }}" data-video-title="{{ video.title }}">
              <div class="d-flex align-items-center position-relative">
                <img src="/{{ video.thumbnail }}" alt="{{ video.title }}" class="img-thumbnail video-thumbnail">
                <i class="fas fa-play-circle play-icon"></i>
              </div>
              <div class="d-flex flex-column ms-3 flex-grow-1">
                <span class="text-start">{{ video.title }}</span>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- About / USPs -->
<section class="bg-off-white">
  <div class="container pt-5 pb-5">
    <div class="row">
      <div class="col-12 col-lg-4 mb-3">
        <h2 class="mb-2">Why Choose Serenade Strings?</h2>
        <ul class="in-brief-list">
          <li class="mb-2"><i class="far fa-check-circle"></i> Modern pop, classical, and film music</li>
          <li class="mb-2"><i class="far fa-check-circle"></i> Bespoke playlists & song requests included</li>
          <li class="mb-2"><i class="far fa-check-circle"></i> Professional, friendly, and flexible musicians</li>
          <li class="mb-2"><i class="far fa-check-circle"></i> Experienced at top venues across Cardiff, London & the UK</li>
          <li class="mb-2"><i class="far fa-check-circle"></i> Available as quartet, trio, or duo</li>
          <li><i class="far fa-check-circle"></i> Quick quotes & personal service from enquiry to performance</li>
        </ul>
      </div>
      <div class="col-12 col-lg-8">
        <article>
          <h2>Live Wedding Music Tailored to You</h2>
          <p>
            Serenade Strings creates the perfect musical backdrop for weddings, civil ceremonies, receptions, and private events. Our repertoire covers everything from Bridgerton-style classical to chart hits, and we love arranging special requests to make your day unique.
          </p>
          <p>
            Based in Cardiff and London, we perform at stunning venues throughout the South West, Wales, and beyond—including Bristol, Somerset, and the Cotswolds. Every booking is personal, and we’re trusted by couples and venues for our reliability, quality, and friendly approach.
          </p>
          <a class="btn btn-primary" href="about.html">Meet the Musicians</a>
        </article>
      </div>
    </div>
  </div>
</section>

<!-- Reviews Header with Background Image -->
<section>
  <div class="container-fluid review-bg" style="min-height:33vh;">
    <div class="overlay d-flex flex-column justify-content-center align-items-center h-100">
      <h2 class="review-title text-center text-white pt-2 pb-2">What Couples Say</h2>
    </div>
  </div>
</section>

<!-- Reviews Grid -->
<section>
  <div class="container py-4">
    <div class="row justify-content-center">
      {% for review in json.reviews %}
      <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-center mb-4">
        <div class="review-card d-flex flex-column justify-content-between h-100 p-4 text-white rounded" style="background:rgba(0,0,0,0.7); max-width: 400px; min-height: 260px;">
          <!-- Review text (top) -->
          <div>
            <p class="mb-2" style="font-size:1.1em;">
              <em>“{{ review.text }}”</em>
            </p>
          </div>
          <!-- Stars and client name (bottom, always aligned) -->
          <div>
            <p class="text-warning mb-1" style="font-size:1.2em;">
              {% for i in [1,2,3,4,5] %}
                <i class="fas fa-star"></i>
              {% endfor %}
            </p>
            <p class="mb-0" style="font-weight:bold;">{{ review.client_name }}</p>
          </div>
        </div>
      </div>

      {% endfor %}
    </div>
  </div>
</section>

<!-- Scripts -->
<script src="/assets/js/videos.js"></script>
<script src="/assets/js/transparent-nav.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const navbarToggler = document.querySelector('.navbar-toggler');
    const jumbotron = document.querySelector('.jumbotron');
    navbarToggler.addEventListener('click', function () {
      jumbotron.classList.toggle('remove-background');
    });
  });
</script>
