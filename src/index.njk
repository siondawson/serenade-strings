---
layout: base.njk
title: Serenade Strings | Wedding String Quartet in Cardiff and London
metaKey: home
---

<!-- callout -->
<section>
    <div class="container-fluid callout-container">
        <div class="opaque-overlay">&nbsp;</div>
        <div class="row">
            <div class="col-12">
                <div class="callout text-center text-white rounded jumbotron">
                    <h1 class="jumbotron-header logo-font text-white">Serenade Strings</h1>
                    <p>Luxury Wedding String Quartet in Cardiff, London and beyond</p>
                    <a href="contact.html" class="btn btn-lg btn-success">Get a free quote!</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- videos -->
<section>
  <div class="container">
    <div class="row pt-5 pb-3">
      <!-- Loaded Video Column (Full width on small screens) -->
      <div class="col-12 col-lg-8 mb-4 mb-md-0">
        <div id="loadedVideo">
          {% set firstVideo = json.videos[0] %}
          <div class="container pt-5">
            <div class="video-wrapper embed-responsive embed-responsive-16by9 d-flex justify-content-center align-items-center">
              <iframe class="embed-responsive-item" 
                      src="https://www.youtube.com/embed/{{ firstVideo.videoId | safe }}" 
                      title="YouTube video player" frameborder="0" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;" 
                      allowfullscreen>
              </iframe>
            </div>
            <div>
              <p class="text-center">Now Playing: {{ firstVideo.title }}</p>
            </div>
          </div>
        </div>
      </div>
      <!-- Video List Column (Full width on small screens) -->
      <div class="col-12 col-lg-4 pb-3">
        <h3 class="pb-2">Select Video <i class="fas fa-play-circle"></i></h3>
        <ul id="videoList" class="list-group text-center">
          {% for video in json.videos %}
            <li class="custom-list-item d-flex justify-content-between align-items-center border-bottom{% if loop.first %} selected-video{% endif %}" 
                data-video-id="{{ video.videoId }}" data-video-title="{{ video.title }}">
              <div class="d-flex align-items-center position-relative">
                <img src="/{{ video.thumbnail }}" alt="{{ video.title }}" class="img-thumbnail video-thumbnail">
                <i class="fas fa-play-circle play-icon"></i>
              </div>
              <div class="d-flex flex-column ms-3 flex-grow-1">
                <span class="text-start">{{ video.title }}</span>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>


<!-- about -->
<section class="bg-off-white">
    <div class="container pt-5 pb-5">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-4 mb-3">
                <h3 class="mb-2">Serenade Strings offer:</h3>
                <ul class="in-brief-list">
                    <li class="mb-2"><i class="far fa-check-circle"></i> Bespoke packages to suit you.</li>
                    <li class="mb-2"><i class="far fa-check-circle"></i> Versatile & Professional Performers.</li>
                    <li class="mb-2"><i class="far fa-check-circle"></i> Vast repertoire covering all styles.</li>
                    <li class="mb-2"><i class="far fa-check-circle"></i> Happy to learn new songs for your booking.</li>
                    <li class="mb-2"><i class="far fa-check-circle"></i> Unique Arrangements of Pop, Rock, Classical & More.</li>
                    <li class="mb-2"><i class="far fa-check-circle"></i> Available U.K. wide and abroad.</li>
                    <li><i class="far fa-check-circle"></i> Dedicated band leader, committed to ensuring the success of your event.</li>
                </ul>
            </div>
            <div class="col-12 col-md-12 col-lg-8">
                <article>
                    <h3>Serenade Strings: Luxury Wedding String Ensemble</h3>
                    <p>Serenade Strings, a distinguished string ensemble specialising in weddings, offers exquisite live music tailored for every moment of your special day. From the ceremony to the reception and the wedding breakfast, Serenade Strings provides unparalleled musical accompaniment that enhances your wedding experience.</p>
                    <p>Renowned for our commitment to excellence, versatility, and sophistication, Serenade Strings brings elegance to weddings across Cardiff, London, Bristol, Somerset, Cotswolds, Wales, the West of England and beyond. With our expertise in crafting enchanting melodies, we ensure that your wedding day is adorned with the perfect soundtrack, creating memories that last a lifetime.</p>
                    <p>Contact us today to discover how Serenade Strings can enhance your wedding with our enchanting string ensemble, and let us bring the magic of live music to your cherished celebration.</p>
                    <a class="btn btn-primary" href="about.html">Learn More</a>
                </article>
            </div>
        </div>
    </div>
</section>

<!-- reviews header with background image -->
<section>
  <div class="container-fluid review-bg" style="min-height:33vh;">
    <div class="overlay d-flex flex-column justify-content-center align-items-center h-100">
      <h2 class="review-title text-center text-white pt-2 pb-2">Reviews</h2>
    </div>
  </div>
</section>

<!-- reviews grid, centered -->
<section>
  <div class="container py-4">
    <div class="row justify-content-center">
      {% for review in json.reviews %}
        <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-center mb-4">
          <div class="review-card p-4 h-100 text-white rounded" style="background:rgba(0,0,0,0.7); max-width: 400px;">
            <p class="mb-2" style="font-size:1.1em;">
              <em>“{{ review.text }}”</em>
            </p>
            <p class="text-warning mb-1" style="font-size:1.2em;">
              {% for i in [1,2,3,4,5] %}
                <i class="fas fa-star"></i>
              {% endfor %}
            </p>
            <p class="mb-0" style="font-weight:bold;">{{ review.client_name }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>





<!-- Scripts (paths updated for new src/assets location) -->
<script src="/assets/js/videos.js"></script>
<script src="/assets/js/transparent-nav.js"></script>

<script>
    // removes background of jumbotron when nav menu is opened
    document.addEventListener("DOMContentLoaded", function () {
        const navbarToggler = document.querySelector('.navbar-toggler');
        const jumbotron = document.querySelector('.jumbotron');

        navbarToggler.addEventListener('click', function () {
            console.log('removing background')
            jumbotron.classList.toggle('remove-background');
        });
    });
</script>
<script>

</script>

